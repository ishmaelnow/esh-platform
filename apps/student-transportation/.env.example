# Public browser configuration only; configure independently from other ESH applications.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enrollment UI gate only. Database program enablement and explicit admission are also required.
NEXT_PUBLIC_STUDENT_ENROLLMENT_ENABLED=false
# Supabase redirect allowlist must include this app's exact /admin and /school URLs.
# Customers return to /school; internal staff return to /admin. Parents cannot enroll.
# Mapping: public rendering token; independently allow this app's origin with the provider.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# SERVER ONLY: trusted geography receipts. Never prefix this credential with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# No payment key or production Student operation is needed.
