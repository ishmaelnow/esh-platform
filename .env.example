# Shared application settings (copy app-specific values to apps/<app>/.env.local)
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=local
LOG_LEVEL=info

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin email and redirects
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INVITATION_FROM_EMAIL=ESH Platform <onboarding@your-verified-domain.com>
INVITATION_BASE_URL=http://localhost:3000
TENANT_ADMIN_BASE_URL=http://localhost:3001
NEXT_PUBLIC_DRIVER_APP_URL=http://localhost:3002
NEXT_PUBLIC_RIDER_APP_URL=http://localhost:3001
NEXT_PUBLIC_COMMUNITY_APP_URL=http://localhost:3003
NEXT_PUBLIC_TRANSPORTATION_ADMIN_URL=http://localhost:3004
NEXT_PUBLIC_ADMIN_SURFACE=control-plane
CRON_SECRET=
NOTIFICATION_DELIVERY_URL=https://admin.eshapp.com/api/internal/notifications/deliver
NOTIFICATION_DELIVERY_SECRET=

# Twilio SMS (server-only; Verify is Rider/Driver, Messaging is Admin)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

# Optional integration and browser-test controls
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
RUN_SUPABASE_RLS_TESTS=false
RUN_SUPABASE_ADMIN_TESTS=false
SUPABASE_TEST_DB_HOST=127.0.0.1
SUPABASE_TEST_DB_PORT=54322
SUPABASE_TEST_DB_USER=postgres
SUPABASE_TEST_DB_PASSWORD=postgres
SUPABASE_TEST_DB_NAME=postgres
ADMIN_INTEGRATION_SUPABASE_URL=http://127.0.0.1:54321
ADMIN_INTEGRATION_SUPABASE_SERVICE_ROLE_KEY=
